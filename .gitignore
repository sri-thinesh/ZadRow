# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/

# Next.js build output
.next/
*/.next/
*/*/.next/
out/
build/
dist/

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs and runtime artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Scratch and transient test directories
mas_agency/scratch/
mas_agency/workspace/sandboxes/
mas_agency/workspace/test_*/
*.tmp

# Pipeline run output — regenerated on every execution, never committed.
# Committing these caused routine test runs to dirty the working tree.
mas_agency/workspace/artifacts/
mas_agency/workspace/docs/
mas_agency/output/

# Raw agent traces (large, machine-generated, may embed local absolute paths)
mas_agency/test_results/logs/

# Generated from A13 master specification on every run
mas_agency/docs/MASTER_SPECIFICATION.md
